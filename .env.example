# PostgreSQL & PostGIS
POSTGRES_DB=civicpulse_db
POSTGRES_USER=civicpulse_user
POSTGRES_PASSWORD=civicpulse_pass
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# FastAPI
PROJECT_NAME="CivicPulse BRICS"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://frontend:3000"]

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://backend:8000

# Google Gemini API (Optional - system automatically uses offline resilient NLU engine if not set)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

